# Agentify configuration template. Copy to .env and edit. Never commit .env.

# --- Windows runtime ------------------------------------------------------
# Path to the WinApp CLI executable. Leave empty to resolve `winapp` from PATH.
AGENTIFY_WINAPP_PATH=
# WinApp CLI version the adapter was verified against; `agentify doctor` warns on mismatch.
AGENTIFY_WINAPP_PINNED_VERSION=0.7.1
# Per-command timeout for `winapp ui` subprocesses (ms), plus a grace period for CLI startup.
AGENTIFY_WINAPP_TIMEOUT_MS=15000
AGENTIFY_WINAPP_STARTUP_GRACE_MS=10000
# Default keyboard transport. post-message is ignored by some controls (e.g. WinForms text boxes).
AGENTIFY_SEND_KEYS_VIA=send-input
# In-process UI Automation for hot operations (false = WinApp CLI only)
AGENTIFY_UIA_FAST_PATH=true
# Only these windows (app ids like notepad:133456, window handles, or process names) are
# visible and actionable; empty = all
AGENTIFY_ALLOWED_WINDOWS=

# --- Execution boundaries -------------------------------------------------
AGENTIFY_MAX_ACTIONS_PER_EXECUTION=40
AGENTIFY_MAX_EXECUTION_SECONDS=180
AGENTIFY_MAX_EXPLORE_SECONDS=1800
# Actions at or above this risk level require explicit approval via the MCP host.
# Levels: read_only < local_configuration_change < data_write < destructive < external_effect
AGENTIFY_APPROVAL_THRESHOLD=data_write
# A candidate becomes active after this many distinct verified parameter sets
AGENTIFY_PROMOTE_AFTER_VERIFIED_PARAM_SETS=2

# --- Explorer sub-agent (Claude Code CLI, uses its own sign-in) -----------
# Leave AGENTIFY_CLAUDE_PATH unset to resolve `claude` from PATH.
# AGENTIFY_CLAUDE_PATH=
AGENTIFY_EXPLORER_MODEL=claude-opus-5-5
AGENTIFY_EXPLORER_EFFORT=medium

# --- Self-repair (experimental, off by default) ---------------------------
# Repair iterations after a failed pre-publish replay
AGENTIFY_EXPLORE_MAX_REPAIRS=0
# Repair a failed capability run at once with the Explorer (skills below data_write risk)
AGENTIFY_AUTO_IMPROVE=false
# Expose the improve_capability tool
AGENTIFY_ENABLE_IMPROVE_TOOL=false

# --- Secrets --------------------------------------------------------------
# Names that ${secret:NAME} references may use (comma-separated), and where values are read from
AGENTIFY_SECRET_NAMES=
AGENTIFY_SECRETS_FILE=.env

# --- Storage --------------------------------------------------------------
AGENTIFY_DATA_DIR=./data
AGENTIFY_DB_PATH=./data/agentify.sqlite
AGENTIFY_SKILLS_DIR=./data/skills
AGENTIFY_SCREENSHOTS_DIR=./data/screenshots

# --- Observability --------------------------------------------------------
AGENTIFY_LOG_LEVEL=INFO
AGENTIFY_LOG_FORMAT=json
